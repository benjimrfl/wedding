---
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import Monogram from '../components/Monogram.astro';
import Countdown from '../components/Countdown.astro';
import Itinerary from '../components/Itinerary.astro';
import Location from '../components/Location.astro';
import Notices from '../components/Notices.astro';
import Faq from '../components/Faq.astro';
import Gifts from '../components/Gifts.astro';
import Footer from '../components/Footer.astro';
import { couple, event, venue } from '../data/wedding';

const title = `${couple.initials[0]} & ${couple.initials[1]} · ${event.dateShort}`;
const description = `¡Nos casamos! ${event.dateLong} en ${venue.name}, ${venue.city}.`;
---

<Layout title={title} description={description}>
  <main>
    <Carousel />
    <Monogram />
    <Countdown />
    <Itinerary />
    <Location />
    <Notices />
    <Faq />
    <Gifts />
  </main>
  <Footer />
</Layout>
