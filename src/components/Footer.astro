---
import { couple, event } from '../data/wedding';
---

<footer class="section--black footer">
  <p class="script gold-text">{couple.initials[0]} &amp; {couple.initials[1]}</p>
  <p class="eyebrow">{event.dateShort}</p>
  <p class="thanks">¡Os esperamos!</p>
</footer>

<style>
  .footer {
    padding: 4rem 1.25rem calc(3rem + env(safe-area-inset-bottom));
    text-align: center;
  }

  .script {
    font-size: 4rem;
    line-height: 1.2;
  }

  .eyebrow {
    margin-top: 0.5rem;
    color: var(--gold-light);
  }

  .thanks {
    margin-top: 1rem;
    font-style: italic;
    opacity: 0.8;
  }
</style>
